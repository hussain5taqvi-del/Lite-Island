<Window x:Class="LiteIsland.WallpaperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="app.ico" Title="LiteIsland Wallpapers" Width="1020" Height="720" MinWidth="780" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#000000" Foreground="White"
        FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: tabs + search -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                <Border Style="{StaticResource GlassPill}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TabWalls" Style="{StaticResource Seg}" Content="Wallpapers" GroupName="tabs"
                                     IsChecked="True" Checked="Tab_Checked" />
                        <RadioButton x:Name="TabLive" Style="{StaticResource Seg}" Content="Live" GroupName="tabs"
                                     Checked="Tab_Checked" />
                        <RadioButton x:Name="TabLib" Style="{StaticResource Seg}" Content="My library" GroupName="tabs"
                                     Checked="Tab_Checked" />
                    </StackPanel>
                </Border>
            </StackPanel>

        </Grid>

        <!-- Wallpaper cards -->
        <Grid Grid.Row="2" Margin="-6,14,-6,0">
            <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          SizeChanged="Scroll_SizeChanged" ScrollChanged="Scroll_Changed">
                <UniformGrid x:Name="Cards" Columns="4" VerticalAlignment="Top" Margin="0,0,4,0" />
            </ScrollViewer>
            <TextBlock x:Name="Status" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondary}" FontSize="14" TextWrapping="Wrap"
                       TextAlignment="Center" MaxWidth="480" />
        </Grid>

        <!-- Bottom bar -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="LatestBtn" Style="{StaticResource Btn}" Margin="0,0,8,0" Click="Latest_Click" Visibility="Collapsed"
                        ToolTip="Sets the newest video from your Downloads folder as live wallpaper">
                    <TextBlock Text="Use latest download" VerticalAlignment="Center" />
                </Button>
                <Button x:Name="AddBtn" Style="{StaticResource Btn}" Margin="0,0,8,0" Click="Add_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 6,0 V 12 M 0,6 H 12" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" VerticalAlignment="Center" Margin="0,0,9,0" />
                        <TextBlock Text="Add picture" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="FolderBtn" Style="{StaticResource Btn}" Click="Folder_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 0.8,2.5 H 5.2 L 6.8,4.2 H 13.2 V 11.5 H 0.8 Z" Stroke="White" StrokeThickness="1.5"
                              StrokeLineJoin="Round" VerticalAlignment="Center" Margin="0,0,9,0" />
                        <TextBlock Text="Open folder" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
